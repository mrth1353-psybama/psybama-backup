# ===== Primary AI API (اصلی) =====
# base URL و اسم مدل را از سرویسی که کلید را از آن گرفته‌اید وارد کنید
PRIMARY_API_KEY=
PRIMARY_BASE_URL=
PRIMARY_MODEL=claude-haiku-4-5

# ===== Groq AI API (جایگزین/fallback) =====
GROQ_API_KEY=gsk-your-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Flask =====
# یک رشته تصادفی طولانی وارد کنید
SECRET_KEY=change-this-to-a-long-random-string-in-production

# ===== Database =====
# مسیر پایگاه داده توسط app.py به صورت خودکار تنظیم می‌شود
# DATABASE_URL=sqlite:///path/to/custom.db

# ===== Admin Panel =====
# پسورد پنل مدیریت را اینجا تنظیم کنید
ADMIN_PASSWORD=admin1234

# ===== SMS Service (فراز اس‌ام‌اس / API جدید api.iranpayamak.com) =====
# local: کد OTP روی صفحه نمایش داده می‌شود (برای تست محلی)
# production: پیامک واقعی ارسال می‌شود
SMS_MODE=local
# کلید API که از پنل فراز اس‌ام‌اس (بخش وب سرویس) می‌گیرید
SMS_API_KEY=
# شماره خط شما از پنل (line_number). اگر خالی باشد از 90008361 استفاده می‌شود
FARAZSMS_SENDER=
# خط پوش / کد یکبارمصرف برای ارسال سریع OTP (برای رفع تأخیر ارسال کد تأیید)
# اگر خط پوش ندارید خالی بگذارید تا از FARAZSMS_SENDER استفاده شود
FARAZSMS_OTP_SENDER=10007840
# کد پترن ساخته‌شده در پنل (برای OTP توصیه می‌شود)
FARAZSMS_PATTERN=
# نام متغیر کد در پترن شما (پیش‌فرض: code)
FARAZSMS_PATTERN_VAR=code
# کد پترن پیامک ثبت‌نام وبینار رایگان گره کور (فراز اس‌ام‌اس)
FARAZSMS_WEBINAR_PATTERN=BF1Ad2lbE7
# نام متغیرهای نام و تاریخ در پترن وبینار؛ خالی بگذارید اگر پترن آن متغیر را ندارد
FARAZSMS_WEBINAR_NAME_VAR=
FARAZSMS_WEBINAR_DATE_VAR=

# ===== Webinar (وبینار رایگان ریشه‌یابی گره کور شغلی) =====
# تاریخ برگزاری وبینار — در صفحه ثبت‌نام موفق و پیامک نمایش داده می‌شود
# اگر خالی باشد عبارت «متعاقباً اعلام می‌شود» نمایش داده می‌شود
KNOT_WEBINAR_DATE=

# ===== Email Notification (اطلاع‌رسانی درخواست مشاوره) =====
# false: ایمیل در لاگ چاپ می‌شود (برای تست محلی)
# true: ایمیل واقعی ارسال می‌شود (برای مثال Gmail App Password)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
# ایمیل‌هایی که اطلاع‌رسانی‌ها به آن‌ها ارسال می‌شود: درخواست مشاوره و ثبت‌نام وبینار (چند آدرس با ویرگول)
NOTIFY_EMAIL=

# ===== ZarinPal Payment Gateway =====
# مرچنت‌کد خود را از پنل زرین‌پال اینجا وارد کنید
ZARINPAL_MERCHANT_ID=
# false = درگاه واقعی | true = sandbox (تست)
ZARINPAL_SANDBOX=true
# آدرس دامنه اصلی سایت (برای callback بعد از پرداخت)
SITE_URL=https://psybama.ir
